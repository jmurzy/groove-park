# Installs the current stable Godot editor. Confirm it matches .godot-version
# before using it for development or exports.
brew "just"
# Provides gdformat/gdlint via: pipx install "gdtoolkit==4.*"
brew "pipx"
# Git hooks for `just check` (just install).
brew "pre-commit"
# GitHub Actions workflow linter (just actionlint-check).
brew "actionlint"
cask "godot"
