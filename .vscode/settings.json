{
  "files.exclude": {
    "**/build": true,
    "**/.godot": true,
    "**/*.gd.uid": true,
    "**/*.import": true,
    "**/*.wrangler": true,
    "**/.alchemy": true,
    "**/node_modules": true,
    "**/.tanstack": true,
    "**/dist": true,
    "**/routeTree.gen.ts": true
  },

  "files.readonlyInclude": {
    "**/routeTree.gen.ts": true
  },

    "files.watcherExclude": {
    "**/routeTree.gen.ts": true
  },

  // @see https://github.com/Microsoft/vscode/issues/6502
  "search.exclude": {
    "**/.git": true,
    "**/build": true,
    "**/.godot": true,
    "**/*.wrangler": true,
    "**/.alchemy": true,
    "**/node_modules": true,
    "**/.tanstack": true,
    "**/dist": true
  },

  "workbench.colorCustomizations": {
    "titleBar.activeBackground": "#76171e"
  },

  "explorer.compactFolders": false,

  "[gdscript]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": false,
    "editor.detectIndentation": false,
    "editor.defaultFormatter": "geequlim.godot-tools",
    "editor.formatOnSave": true
  },

  "godotTools.editorPath.godot4": "/Applications/Godot 4.6.3.app/Contents/MacOS/Godot",
  "godotTools.lsp.headless": true,

  "[javascript]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[javascriptreact]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[typescript]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[typescriptreact]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[json]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[jsonc]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[css]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"editor.codeActionsOnSave": {
		"source.organizeImports.biome": "explicit"
	}
}
