set default-list := true

[default]
[doc("List available commands.")]
help:
    @just --list

[doc("Install locked Node.js dependencies.")]
install:
    npm ci

[doc("Run the local Cloudflare Worker development server. Extra arguments are forwarded to Alchemy.")]
dev *args:
    npm run dev -- {{ args }}

format-check:
  npm run format

format:
  npm run format -- --fix

lint-check:
  npm run lint

lint:
  npm run lint -- --fix

typecheck:
  npm run typecheck

[doc("Run the Worker test suite.")]
test:
    npm test

[doc("Run type checks and tests.")]
check: format-check lint-check typecheck test

[doc("Deploy the Worker using the configured Cloudflare credentials. Extra arguments are forwarded to Alchemy.")]
deploy *args:
    npm run deploy -- {{ args }}
