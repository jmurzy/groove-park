{
	"name": "web",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "ALCHEMY_PROFILE=gunbarrelhaus alchemy dev --config alchemy.run.ts --stage development --env-file .env",
		"generate-routes": "tsr generate",
		"format": "biome format",
		"lint": "biome lint",
		"typecheck": "tsc --noEmit",
		"plan": "alchemy plan --detailed --config alchemy.run.ts --stage production",
		"deploy": "alchemy deploy --config alchemy.run.ts --stage production",
		"destroy": "alchemy destroy --config alchemy.run.ts --stage production",
		"plan:zone": "alchemy plan --detailed --config zone.alchemy.run.ts --stage production",
		"deploy:zone": "alchemy deploy --config zone.alchemy.run.ts --stage production",
		"destroy:zone": "alchemy destroy --config zone.alchemy.run.ts --stage production"
	},
	"dependencies": {
		"@tanstack/react-devtools": "0.10.13",
		"@tanstack/react-router": "1.170.42",
		"@tanstack/react-router-devtools": "1.167.2",
		"@tanstack/react-start": "1.168.61",
		"@tanstack/start-storage-context": "1.167.37",
		"alchemy": "^2.0.0-beta.83",
		"effect": "^4.0.2",
		"react": "^19.2.0",
		"react-dom": "^19.2.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@effect/platform-node": "^4.0.2",
		"@tanstack/devtools-vite": "0.8.5",
		"@tanstack/router-cli": "^1.132.0",
		"@types/node": "^22.10.2",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"typescript": "^6.0.2",
		"vite": "^8.0.0"
	}
}
