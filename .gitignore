# Dev: copy to ./heavenly.cfg (repo root, read via res://).
# Cabinet: copy to heavenly.cfg next to HEAVENLY.exe. Never commit.
heavenly.cfg

# Godot generated cache / import artifacts (regenerated by `just import` / editor)
.godot/

